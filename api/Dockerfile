# ============================================================
# Project 05 - Step 05
# Node.js TypeScript Multi-stage Dockerfile
# ============================================================
#
# Build 分成：
#
#   Stage 1：build
#       ↓
#   TypeScript → JavaScript
#
#   Stage 2：runtime
#       ↓
#   只保留執行 Production API 需要的東西
#
# ============================================================


# ============================================================
# Stage 1：Build
# ============================================================

FROM node:24-bookworm-slim AS build


# ------------------------------------------------------------
# WORKDIR
# ------------------------------------------------------------
#
# 後面：
#
#   COPY
#   RUN
#
# 等相對路徑操作，都以：
#
#   /app
#
# 為工作目錄。
#
WORKDIR /app


# ------------------------------------------------------------
# 先複製 package files
# ------------------------------------------------------------
#
# package.json
# package-lock.json
#
# 先獨立 COPY 有一個很大的好處：
#
# Docker Layer Cache
#
# 如果只有 src/app.ts 改變，
# package files 沒有改，
# npm ci 那一層有機會直接使用 Cache。
#
COPY package*.json ./


# ------------------------------------------------------------
# npm ci
# ------------------------------------------------------------
#
# 和 npm install 相比：
#
# npm ci 會按照 package-lock.json
# 安裝確定版本。
#
# Build Stage 需要：
#
#   typescript
#   @types/*
#
# 所以這裡包含 devDependencies。
#
RUN npm ci


# ------------------------------------------------------------
# 複製 TypeScript Configuration
# ------------------------------------------------------------

COPY tsconfig.json ./


# ------------------------------------------------------------
# 複製 Source Code
# ------------------------------------------------------------

COPY src ./src


# ------------------------------------------------------------
# TypeScript Build
# ------------------------------------------------------------
#
# 等同：
#
#   tsc
#
# 產生：
#
#   /app/dist/app.js
#
RUN npm run build



# ============================================================
# Stage 2：Runtime
# ============================================================
#
# 開一個乾淨的新 Stage。
#
# Build Stage 裡：
#
#   TypeScript compiler
#   tsx
#   原始 TypeScript
#
# 都不需要全部帶到 Runtime。
#
FROM node:24-bookworm-slim AS runtime


# ------------------------------------------------------------
# Production Environment
# ------------------------------------------------------------

ENV NODE_ENV=production


WORKDIR /app


# ------------------------------------------------------------
# 複製 package files
# ------------------------------------------------------------

COPY package*.json ./


# ------------------------------------------------------------
# 只安裝 Production Dependencies
# ------------------------------------------------------------
#
# --omit=dev
#
# 不安裝：
#
#   typescript
#   tsx
#   @types/*
#
# Runtime 真正需要的主要是：
#
#   express
#
RUN npm ci --omit=dev \
  && npm cache clean --force


# ------------------------------------------------------------
# 從 Build Stage 拿編譯結果
# ------------------------------------------------------------
#
# 注意：
#
# 不是從 Host 複製。
#
# 是：
#
#   build Stage
#       ↓
#   runtime Stage
#
COPY --from=build /app/dist ./dist


# ------------------------------------------------------------
# EXPOSE
# ------------------------------------------------------------
#
# 表達這個 Image 裡的 Application
# 預期使用：
#
#   TCP 3000
#
# 注意：
#
# EXPOSE 本身不等於 Host Port Mapping。
#
# 真正：
#
#   Host 3000 → Container 3000
#
# 是等等 compose.yaml 的 ports。
#
EXPOSE 3000


# ------------------------------------------------------------
# 非 root User
# ------------------------------------------------------------
#
# 官方 Node Image 已經提供：
#
#   node
#
# 使用一般使用者執行 Application，
# 不需要讓 Express 以 root 身分執行。
#
USER node


# ------------------------------------------------------------
# Container 啟動指令
# ------------------------------------------------------------
#
# 最終實際執行：
#
#   node dist/app.js
#
CMD ["node", "dist/app.js"]